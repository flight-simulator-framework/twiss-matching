   <property name="styleSheet">
    <string notr="true">QGroupBox {
    background-color: rgb(245, 245, 245);
    border: 1px solid rgb(210, 210, 210);
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
}
QToolButton {
    border: 1px solid #888;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0px;
    font-weight: bold;
}
QToolButton:hover {
    background-color: #e6e6e6;
}</string>
