      <property name="currentIndex">
       <number>0</number>
      </property>
      <widget class="QWidget" name="matchingTab">
       <attribute name="title">
        <string>Matching</string>
       </attribute>
       <layout class="QVBoxLayout" name="matchingVBox">
        <item>
         <layout class="QHBoxLayout" name="plotSelectorsHBox">
          <item>
           <widget class="QLabel" name="label_plot_quantity">
