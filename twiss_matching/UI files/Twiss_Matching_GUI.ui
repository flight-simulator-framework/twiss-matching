          <item>
           <layout class="QHBoxLayout" name="targetPresetsHBox">
            <item>
             <widget class="QPushButton" name="waist_button">
              <property name="toolTip">
               <string>Sets α = 0 in both planes, i.e. the beam has its smallest size (a waist) at the target location.</string>
              </property>
              <property name="text">
               <string>Waist (α = 0)</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="round_beam_button">
              <property name="toolTip">
               <string>Sets the vertical target so that σy = σx with the incoming emittances.</string>
              </property>
              <property name="text">
               <string>Round beam (σx = σy)</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="design_twiss_button">
              <property name="toolTip">
               <string>Copies the design Twiss parameters of the model at the target location into the target fields.</string>
              </property>
