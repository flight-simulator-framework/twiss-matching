                    <string>σx [mm]</string>
                   </property>
                  </row>
                  <row>
                   <property name="text">
                    <string>σy [mm]</string>
                   </property>
                  </row>
                  <row>
                   <property name="text">
                    <string>Bmag x</string>
                   </property>
                  </row>
                  <row>
                   <property name="text">
                    <string>Bmag y</string>
                   </property>
