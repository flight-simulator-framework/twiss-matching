              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QGridLayout" name="targetConstraintsGrid">
            <item row="0" column="0">
             <widget class="QCheckBox" name="use_beta_max">
              <property name="text">
               <string>β max along the line [m]</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QDoubleSpinBox" name="beta_max">
              <property name="decimals">
               <number>1</number>
              </property>
              <property name="maximum">
               <double>100000.000000000000000</double>
              </property>
              <property name="value">
               <double>200.000000000000000</double>
              </property>
             </widget>
            </item>
            <item row="0" column="2">
             <widget class="QToolButton" name="beta_max_tooltip">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Inequality constraint: β stays below this value everywhere between the reference point and the target location.&lt;/p&gt;&lt;p&gt;It keeps the beam away from the aperture and rejects solutions with very strong focusing.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="label_tolerance">
              <property name="text">
               <string>Tolerance (Bmag − 1)</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QDoubleSpinBox" name="tolerance">
              <property name="decimals">
               <number>3</number>
              </property>
              <property name="maximum">
               <double>10.000000000000000</double>
              </property>
              <property name="singleStep">
               <double>0.010000000000000</double>
              </property>
              <property name="value">
               <double>0.010000000000000</double>
              </property>
             </widget>
            </item>
            <item row="1" column="2">
             <widget class="QToolButton" name="tolerance_tooltip">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Bmag = ½ (β γ&lt;sub&gt;t&lt;/sub&gt; − 2 α α&lt;sub&gt;t&lt;/sub&gt; + γ β&lt;sub&gt;t&lt;/sub&gt;) compares the matched ellipse (β, α, γ) with the target ellipse (β&lt;sub&gt;t&lt;/sub&gt;, α&lt;sub&gt;t&lt;/sub&gt;, γ&lt;sub&gt;t&lt;/sub&gt;).&lt;/p&gt;&lt;p&gt;Bmag = 1 is a perfect match. The matching stops when Bmag − 1 is below this tolerance in both planes.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
            <item row="2" column="0" colspan="2">
             <widget class="QLabel" name="dof_label">
              <property name="text">
               <string>Constraints: 0 · Matching quadrupoles: 0</string>
              </property>
             </widget>
            </item>
            <item row="2" column="2">
             <widget class="QToolButton" name="dof_tooltip">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Every ticked target value is one constraint, every matching quadrupole is one knob.&lt;/p&gt;&lt;p&gt;For an exact solution you need at least as many knobs as constraints, e.g. 4 quadrupoles for βx, αx, βy, αy. With fewer knobs the solver returns the best compromise (weighted least squares).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="computingMethodGroup">
         <property name="title">
          <string>Matching engine</string>
         </property>
         <layout class="QGridLayout" name="gridComputingMethod">
          <item row="0" column="0">
           <widget class="QLabel" name="label_computing_method">
            <property name="text">
             <string>Computing method</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="computing_method_combo">
            <item>
             <property name="text">
              <string>Linear R-matrix model</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>RF-Track tracking</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Online (measured beam sizes)</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QToolButton" name="computing_method_tooltip">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Linear R-matrix model&lt;/b&gt;: transports the Twiss parameters with the transfer matrices of the model. Fast, used to find the starting solution.&lt;/p&gt;&lt;p&gt;&lt;b&gt;RF-Track tracking&lt;/b&gt;: tracks the incoming beam through the model, including energy spread and nonlinear effects. Starts from the linear solution.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Online&lt;/b&gt;: changes the quadrupoles on the machine and minimizes the difference between the measured and requested beam sizes on the target screen. Model independent, but slow and it needs beam time.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_restarts">
            <property name="text">
             <string>Random restarts</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="restarts">
            <property name="maximum">
             <number>1000</number>
            </property>
            <property name="value">
             <number>20</number>
            </property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QToolButton" name="restarts_tooltip">
            <property name="toolTip">
             <string>Matching usually has several solutions. The solver starts from random quadrupole currents within the limits and keeps the solution with the smallest current change and the smallest β along the line.</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_current_change_weight">
            <property name="text">
             <string>Current change penalty</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="current_change_weight">
            <property name="decimals">
             <number>4</number>
            </property>
            <property name="singleStep">
             <double>0.001000000000000</double>
            </property>
            <property name="value">
             <double>0.001000000000000</double>
            </property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="QToolButton" name="current_change_weight_tooltip">
            <property name="toolTip">
             <string>Weight of the difference between the proposed and the present currents. Higher values prefer solutions close to the present machine settings.</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="applyGroup">
         <property name="title">
          <string>Apply settings</string>
         </property>
         <layout class="QGridLayout" name="gridApply">
          <item row="0" column="0">
           <widget class="QLabel" name="label_ramp_steps">
            <property name="text">
             <string>Ramp steps</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="ramp_steps">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>5</number>
            </property>
           </widget>
          </item>
          <item row="0" column="2" rowspan="3">
           <widget class="QToolButton" name="apply_tooltip">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Before applying, the present machine state is saved as the reference.&lt;/p&gt;&lt;p&gt;The currents are ramped from the present to the proposed values in the given number of steps. After every step the transmission is read from the last ICT; if it drops below the limit, the ramp stops and the reference is restored.&lt;/p&gt;&lt;p&gt;Measurements per step is the number of shots averaged on the screens during verification.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_min_transmission">
            <property name="text">
             <string>Min. transmission [%]</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="min_transmission">
            <property name="decimals">
             <number>0</number>
            </property>
            <property name="maximum">
             <double>100.000000000000000</double>
            </property>
            <property name="value">
             <double>80.000000000000000</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_meas_per_step">
            <property name="text">
             <string>Measurements per step</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="meas_per_step">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="value">
             <number>5</number>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="actionsGroup">
         <property name="title">
          <string>Databases</string>
         </property>
         <layout class="QGridLayout" name="gridActions">
          <property name="spacing">
           <number>12</number>
          </property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_session_directory">
            <property name="text">
             <string>Session directory</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="session_directory">
            <property name="minimumSize">
             <size>
              <width>420</width>
              <height>0</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QPushButton" name="load_session_button">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="text">
             <string>...</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QProgressBar" name="progressBar">
         <property name="value">
          <number>0</number>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QTabWidget" name="tabs">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>1</horstretch>
        <verstretch>1</verstretch>
