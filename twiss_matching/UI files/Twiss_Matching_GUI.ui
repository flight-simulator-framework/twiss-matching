                  </column>
                  <column>
                   <property name="text">
                    <string>Max [A]</string>
                   </property>
                  </column>
                  <column>
                   <property name="text">
                    <string>Proposed [A]</string>
                   </property>
                  </column>
                  <column>
                   <property name="text">
                    <string>Δ [A]</string>
                   </property>
                  </column>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item>
              <layout class="QGridLayout" name="solutionButtonsGrid">
               <item row="0" column="0">
                <widget class="QPushButton" name="log_console_button">
                 <property name="text">
                  <string>Log Console</string>
                 </property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QPushButton" name="phase_space_button">
                 <property name="text">
                  <string>Show phase space at the target</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QPushButton" name="save_reference_button">
                 <property name="text">
                  <string>Save reference state</string>
                 </property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QPushButton" name="load_reference_button">
                 <property name="text">
                  <string>Load reference state...</string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
             <item>
              <widget class="QLabel" name="logo_label">
               <property name="minimumSize">
                <size>
                 <width>120</width>
                 <height>60</height>
                </size>
               </property>
               <property name="text">
                <string/>
               </property>
               <property name="alignment">
                <set>Qt::AlignCenter</set>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="computeHBox">
          <item>
           <widget class="QToolButton" name="compute_tooltip">
            <property name="toolTip">
             <string>Runs the selected matching engine. The proposed currents are only computed and displayed, nothing is sent to the machine.</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="compute_button">
            <property name="styleSheet">
             <string notr="true">background-color: red; color: white;</string>
            </property>
            <property name="text">
             <string>COMPUTE MATCHING</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="stop_button">
            <property name="styleSheet">
             <string notr="true">background-color: green; color: white;</string>
            </property>
            <property name="text">
             <string>STOP MATCHING</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="applyHBox">
          <item>
           <widget class="QToolButton" name="apply_buttons_tooltip">
            <property name="toolTip">
             <string>APPLY TO MACHINE saves the reference state and ramps the matching quadrupoles to the proposed currents. RESTORE REFERENCE sets the saved currents back.</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="apply_button">
            <property name="styleSheet">
             <string notr="true">background-color: red; color: white;</string>
            </property>
            <property name="text">
             <string>APPLY TO MACHINE</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="restore_reference_button">
            <property name="styleSheet">
             <string notr="true">background-color: green; color: white;</string>
            </property>
            <property name="text">
             <string>RESTORE REFERENCE</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="verifyHBox">
          <item>
           <widget class="QToolButton" name="verify_tooltip">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;VERIFY ON SCREENS&lt;/b&gt;: measures the beam sizes on the screens between the reference point and the target and compares them with the prediction (Verification tab).&lt;/p&gt;&lt;p&gt;&lt;b&gt;MEASURE TWISS&lt;/b&gt;: runs a quadrupole scan with the Emittance Measurement engine to measure the Twiss parameters at the target location.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="verify_button">
            <property name="text">
             <string>VERIFY ON SCREENS</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="measure_twiss_button">
            <property name="text">
             <string>MEASURE TWISS (QUADRUPOLE SCAN)</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="verificationTab">
       <attribute name="title">
        <string>Verification</string>
       </attribute>
       <layout class="QVBoxLayout" name="verificationVBox">
        <item>
         <layout class="QHBoxLayout" name="verificationHBox">
          <item>
           <widget class="QWidget" name="verifyPlotPlaceholder" native="true">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimumSize">
             <size>
              <width>500</width>
              <height>500</height>
             </size>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="iterations_group">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Preferred">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimumSize">
             <size>
              <width>520</width>
              <height>0</height>
             </size>
            </property>
            <property name="title">
             <string>Iterations</string>
            </property>
            <layout class="QVBoxLayout" name="iterationsVBox">
             <item>
              <widget class="QTableWidget" name="iterations_table">
               <property name="editTriggers">
                <set>QAbstractItemView::NoEditTriggers</set>
               </property>
               <attribute name="verticalHeaderVisible">
                <bool>false</bool>
               </attribute>
               <column>
                <property name="text">
                 <string>Iteration</string>
                </property>
               </column>
               <column>
                <property name="text">
                 <string>Bmag x</string>
                </property>
               </column>
               <column>
                <property name="text">
                 <string>Bmag y</string>
                </property>
               </column>
               <column>
                <property name="text">
                 <string>σx error [%]</string>
                </property>
               </column>
               <column>
                <property name="text">
                 <string>σy error [%]</string>
                </property>
               </column>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="iterateHBox">
          <item>
           <widget class="QToolButton" name="iterate_tooltip">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Takes the last measurement as the new incoming beam and computes the next correction from the present machine state.&lt;/p&gt;&lt;p&gt;Usually 2–3 iterations are needed, because the model is not perfect (quadrupole calibration, beam energy).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>?</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="iterate_button">
            <property name="styleSheet">
             <string notr="true">background-color: red; color: white;</string>
            </property>
            <property name="text">
             <string>USE MEASURED BEAM AND COMPUTE NEXT ITERATION</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
</ui>
