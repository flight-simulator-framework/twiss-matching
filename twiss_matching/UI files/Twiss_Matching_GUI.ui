                  <column>
                   <property name="text">
                    <string>Target</string>
                   </property>
                  </column>
                  <column>
                   <property name="text">
                    <string>Present</string>
                   </property>
                  </column>
                  <column>
                   <property name="text">
                    <string>Matched</string>
                   </property>
                  </column>
                  <column>
                   <property name="text">
                    <string>Measured</string>
                   </property>
                  </column>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="quads_results_group">
               <property name="title">
                <string>Quadrupole settings</string>
               </property>
               <layout class="QVBoxLayout" name="quadsResultsVBox">
                <item>
                 <widget class="QTableWidget" name="quads_table">
